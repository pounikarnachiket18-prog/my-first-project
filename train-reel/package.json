{
  "name": "train-announcement-reel",
  "version": "1.0.0",
  "description": "Reel: why Indian railway announcements come in pauses (Remotion motion graphics)",
  "scripts": {
    "start": "remotion studio",
    "audio": "python3 scripts/make_audio.py",

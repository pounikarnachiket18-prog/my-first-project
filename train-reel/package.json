    "@fontsource/noto-sans-bengali": "^5.1.1",
    "@fontsource/noto-sans-devanagari": "5.1.1",
    "@fontsource/noto-sans-tamil": "^5.1.1",
    "@fontsource/noto-sans-telugu": "^5.1.1",
    "@fontsource/vt323": "5.1.1",
    "@remotion/cli": "4.0.469",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.469"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}

{
  "name": "cinematic-product-video",
  "version": "1.0.0",
  "description": "Cinematic product video built with Remotion",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render Main out/video-16x9.mp4",
    "render:mobile": "remotion render MainMobile out/video-9x16.mp4",
    "thumbs": "remotion still Thumb16x9 out/thumb-16x9.png && remotion still Thumb9x16 out/thumb-9x16.png",
    "all": "npm run render && npm run render:mobile && npm run thumbs",
    "upgrade": "remotion upgrade",
    "mosquito:studio": "remotion studio src/mosquito/index.ts",
    "mosquito:audio": "python3 scripts/generate_audio.py",
    "mosquito:preview": "remotion render src/mosquito/index.ts JustKnowIt-Mosquito out/jki-mosquito-preview.mp4 --scale=0.5 --crf=26",
    "mosquito:render": "remotion render src/mosquito/index.ts JustKnowIt-Mosquito out/jki-mosquito-final.mp4 --crf=16 --x264-preset=slow",
    "mosquito:typeface": "node scripts/make-typeface.mjs assets/InterTight-Black.ttf public/jki/fonts/InterTight-Black.typeface.json"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@remotion/cli": "4.0.469",
    "@remotion/google-fonts": "4.0.469",
    "@remotion/layout-utils": "4.0.469",
    "@remotion/noise": "4.0.469",
    "@remotion/paths": "4.0.469",
    "@remotion/shapes": "4.0.469",
    "@remotion/three": "4.0.469",
    "@remotion/transitions": "4.0.469",
    "@types/three": "0.170.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.469",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "opentype.js": "1.3.4",
    "typescript": "5.6.3"
  }
}
